# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Session signing key for doctor/admin logins (64 hex chars).
#   generate:  openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key used to encrypt every stored patient record at rest (64 hex chars).
#   generate:  openssl rand -hex 32
#   WARNING: changing this makes existing records unreadable.
DATA_KEY=

# One-time key that guards POST /api/setup (creates the first admin account).
#   generate:  openssl rand -hex 16
SETUP_KEY=

# Google Gemini API key — powers AI drafting in the doctor portal
# (clinical summaries and patient letters). Optional: without it the
# portal simply hides those buttons. The model never chooses a drug,
# a dose, or whether a patient is eligible.
#   get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (defaults to gemini-2.5-flash).
GEMINI_MODEL=

# Vercel Blob private store token — only needed for cloud deploys.
# Provided automatically on Vercel; leave blank for local development
# (local runs store data in ./.localdata instead).
BLOB_READ_WRITE_TOKEN=
